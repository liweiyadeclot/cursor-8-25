{
  "name": "单个序号Excel到MCP工作流",
  "description": "处理单个序号的报销单，从Excel生成提示词并执行",
  "variables": {
    "excel_path": "C:\\Users\\FH\\source\\repos\\Auto Finan\\Auto Finan\\420财务050823.xlsx",
    "sheet_name": "3-报销",
    "serial": "1",
    "mcp_endpoint": "http://localhost:3030/mcp/execute"
  },
  "steps": [
    {
      "type": "log",
      "message": "开始处理序号: ${serial}"
    },
    {
      "type": "excel_to_prompt",
      "name": "从Excel生成MCP提示词",
      "excel_path": "${excel_path}",
      "sheet_name": "${sheet_name}",
      "serial": "${serial}",
      "use_llm": true,
      "save_to": "mcp_prompt"
    },
    {
      "type": "log",
      "message": "生成的MCP提示词预览: ${mcp_prompt.substring(0, 200)}..."
    },
    {
      "type": "mcp",
      "name": "执行MCP提示词",
      "prompt": "${mcp_prompt}",
      "timeout": 300,
      "browser": "chrome",
      "headless": false,
      "save_result_to": "execution_result"
    },
    {
      "type": "log",
      "message": "执行完成，状态: ${execution_result.status}"
    }
  ]
}

